LR_IROM1 0x0800C000 0x00033FFF  {   ; load region size_region
  ER_IROM1 0x0800C000 0x00033FFF  { ; load address = execution address
   *.o (RESET, +First)				; 1. 中断向量表
   
   . = 0x200						; 位置计数器增加
   version_section.o (+RO)			; 2. 版本信息
   
   *(InRoot$$Sections)			 	; 3. 库相关的重要段
   .ANY (+RO)					 	; 4. 其他的只读数据和代码
   .ANY (+XO)						; 5. 其他的可执行代码
  }
  RW_IRAM1 0x20000000 0x00020000  { ; RW data
   .ANY (+RW +ZI)					; 所有的读写数据
  }
}

